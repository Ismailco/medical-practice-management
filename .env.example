# Local development placeholders only. Never put production secrets in this file.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://clinic_demo:clinic_demo_only@localhost:5432/clinic_demo
BETTER_AUTH_SECRET=replace-with-output-from-openssl-rand-base64-32
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=1
AUTH_TRUSTED_PROXY_CIDRS=

# Used by the local PostgreSQL Docker Compose service only.
POSTGRES_DB=clinic_demo
POSTGRES_USER=clinic_demo
POSTGRES_PASSWORD=clinic_demo_only
